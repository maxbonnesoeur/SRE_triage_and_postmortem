# =============================================================================
# SRE Triage & Postmortem Commander - Environment Configuration
# =============================================================================

# --- Model Provider (choose either Google AI Studio OR Vertex AI) ---
# Option A: Google AI Studio (local dev)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key-here

# Option B: Vertex AI (recommended for Cloud Run / Enterprise production)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Model Selection ---
SRE_AGENT_MODEL=gemini-3.8-flash
SRE_AGENT_PRO_MODEL=gemini-3.8-flash

# --- Persistence & Memory ---
SRE_MEMORY_DB_PATH=./data/incident_memory.db
SRE_SESSION_DB_URL=sqlite+aiosqlite:///./data/adk_sessions.db

# --- Tooling & Safety Guardrails ---
# Set to true to connect telemetry tools via the local stdio MCP server
SRE_USE_MCP_TOOLS=false
# Require explicit human approval token before destructive remediation actions
SRE_REQUIRE_APPROVAL_FOR_DESTRUCTIVE_OPS=true
# Max refinement iterations for RemediationPlanner <-> SafetyCritic loop
SRE_MAX_REMEDIATION_ITERATIONS=3

# --- Observability & Tracing ---
SRE_SERVICE_NAME=sre-triage-agent
SRE_LOG_LEVEL=INFO
# Exporter: "none" | "console" | "otlp" | "gcp_trace"
SRE_OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Server ---
PORT=8080
HOST=0.0.0.0
